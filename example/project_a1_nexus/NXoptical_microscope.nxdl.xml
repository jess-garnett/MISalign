<definition xmlns="http://definition.nexusformat.org/nxdl/3.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" category="application" type="group" name="NXoptical_microscopy" extends="NXobject" xsi:schemaLocation="http://definition.nexusformat.org/nxdl/3.1 ../nxdl.xsd">
    <symbols>
        <symbol name="n_k">
            <doc>
                Number of image points along the slow dimension (k equivalent to z).
            </doc>
        </symbol>
        <symbol name="n_j">
            <doc>
                Number of image points along the fast dimension (j equivalent to y).
            </doc>
        </symbol>
        <symbol name="n_i">
            <doc>
                Number of image points along the fastest dimension (i equivalent to x).
            </doc>
        </symbol>
    </symbols>
    <doc>
        Application definition for an optical microscopy experiment.
    </doc>
    <group type="NXentry">
        <field name="definition">
            <enumeration>
                <item value="NXoptical_microscopy"/>
            </enumeration>
        </field>
        <field name="title"/>
        <group type="NXinstrument">
            <group name="microscope" type="NXcomponent">
                <field name="description" type="NX_CHAR">
                    <doc>
                        Description of the microscope.
                    </doc>
                </field>
            </group>
            <group name="detector" type="NXdetector">
                <field name="description" type="NX_CHAR"/>
                <group name="imageID" type="NXimage"/>
            </group>
            <group name="objective" type="NXoptical_lens">
                <field name="description" type="NX_CHAR"/>
                <field name="magnification" type="NX_FLOAT"/>
                <field name="numerical_aperture" type="NX_NUMBER"/>
            </group>
        </group>
        <group name="images" type="NXobject">
            <group name="image_ID" type="NXimage">
                <group name="image_3d" type="NXdata">
                    <attribute name="signal">
                        <enumeration>
                            <item value="intensity"/>
                        </enumeration>
                    </attribute>
                    <attribute name="axes">
                        <enumeration>
                            <item value="['axis_i', 'axis_j']"/>
                        </enumeration>
                    </attribute>
                    <field name="intensity" type="NX_NUMBER">
                        <dimensions rank="3">
                            <dim index="1" value="n_k"/>
                            <dim index="2" value="n_j"/>
                            <dim index="3" value="n_i"/>
                        </dimensions>
                    </field>
                    <field name="axis_k" type="NX_NUMBER">
                        <dimensions rank="1">
                            <dim index="1" value="n_k"/>
                        </dimensions>
                    </field>
                    <field name="axis_j" type="NX_NUMBER">
                        <dimensions rank="1">
                            <dim index="1" value="n_j"/>
                        </dimensions>
                    </field>
                    <field name="axis_i" type="NX_NUMBER">
                        <dimensions rank="1">
                            <dim index="1" value="n_i"/>
                        </dimensions>
                    </field>
                </group>
            </group>
        </group>
    </group>
</definition>
